<resources>
    <attr name="colorOn" format="reference" />
    <attr name="colorOff" format="reference" />
    <attr name="expander" format="reference" />
    <attr name="iconQueue" format="reference" />
    <attr name="iconMetered" format="reference" />
    <attr name="iconSettings" format="reference" />
    <attr name="iconDatasaver" format="reference" />
    <attr name="iconLaunch" format="reference" />
    <attr name="iconDelete" format="reference" />
    <attr name="iconPlay" format="reference" />
    <attr name="iconPause" format="reference" />

    <style name="AppDialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AmniGuard.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.AmniGuard.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.AmniGuard.DialogButton</item>
    </style>

    <style name="ThemeOverlay.AmniGuard.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AmniGuard.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.AmniGuard.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.AmniGuard.DialogButton</item>
    </style>

    <style name="Widget.AmniGuard.DialogButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AmniGuard.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <style name="ThemeOverlay.AmniGuard.PopupMenu" parent="ThemeOverlay.Material3">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/colorCosmicTextSecondary</item>
    </style>

    <style name="Widget.AmniGuard.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <!-- Base Light Theme (High Contrast Emerald/Sand Style) -->
    <style name="BaseThemeLight" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="expander">@drawable/expander_black</item>
        <item name="iconQueue">@drawable/ic_hourglass_empty_black_24dp</item>
        <item name="iconMetered">@drawable/ic_attach_money_black_24dp</item>
        <item name="iconSettings">@drawable/ic_settings_black_24dp</item>
        <item name="iconDatasaver">@drawable/ic_perm_data_setting_black_24dp</item>
        <item name="iconLaunch">@drawable/ic_launch_black_24dp</item>
        <item name="iconDelete">@drawable/ic_delete_black_24dp</item>
        <item name="iconPlay">@drawable/ic_play_arrow_black_24dp</item>
        <item name="iconPause">@drawable/ic_pause_black_24dp</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>

        <!-- Strong Contrast Text Colors -->
        <item name="android:textColorPrimary">@color/md_theme_onBackground</item>
        <item name="android:textColorSecondary">@color/md_theme_onSurfaceVariant</item>
        <item name="android:textColorTertiary">@color/md_theme_outline</item>

        <!-- Surface and Background Colors -->
        <item name="android:windowBackground">@color/md_theme_background</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>

        <!-- Dialogs & Menus -->
        <item name="alertDialogTheme">@style/ThemeOverlay.AmniGuard.MaterialAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AmniGuard.MaterialAlertDialog</item>
        <item name="popupMenuStyle">@style/Widget.AmniGuard.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.AmniGuard.PopupMenu</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.AmniGuard.PopupMenu</item>
        <item name="popupTheme">@style/ThemeOverlay.AmniGuard.PopupMenu</item>
        <item name="spinnerStyle">@style/Widget.AmniGuard.Spinner</item>

        <!-- Navigation Styles -->
        <item name="bottomNavigationStyle">@style/Widget.AmniGuard.BottomNavigation</item>
        <item name="navigationViewStyle">@style/Widget.AmniGuard.NavigationDrawer</item>
    </style>

    <!-- Base Dark Theme (High Contrast Cosmic/Deep Tech Style) -->
    <style name="BaseThemeDark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="expander">@drawable/expander_white</item>
        <item name="iconQueue">@drawable/ic_hourglass_empty_white_24dp</item>
        <item name="iconMetered">@drawable/ic_attach_money_white_24dp</item>
        <item name="iconSettings">@drawable/ic_settings_white_24dp</item>
        <item name="iconDatasaver">@drawable/ic_perm_data_setting_white_24dp</item>
        <item name="iconLaunch">@drawable/ic_launch_white_24dp</item>
        <item name="iconDelete">@drawable/ic_delete_white_24dp</item>
        <item name="iconPlay">@drawable/ic_play_arrow_white_24dp</item>
        <item name="iconPause">@drawable/ic_pause_white_24dp</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>

        <!-- Strong Contrast Text Colors -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/colorCosmicTextSecondary</item>
        <item name="android:textColorTertiary">@color/colorCosmicTextTertiary</item>

        <!-- Surface and Background Colors -->
        <item name="android:windowBackground">@color/colorCosmicBg</item>
        <item name="android:colorBackground">@color/colorCosmicBg</item>
        <item name="colorSurface">@color/colorCosmicSurface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/colorCosmicSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorCosmicOnSurfaceVariant</item>
        <item name="colorOutline">@color/colorCosmicOutline</item>
        <item name="colorOutlineVariant">@color/colorCosmicOutlineVariant</item>

        <!-- Dialogs & Menus -->
        <item name="alertDialogTheme">@style/ThemeOverlay.AmniGuard.MaterialAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AmniGuard.MaterialAlertDialog</item>
        <item name="popupMenuStyle">@style/Widget.AmniGuard.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.AmniGuard.PopupMenu</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.AmniGuard.PopupMenu</item>
        <item name="popupTheme">@style/ThemeOverlay.AmniGuard.PopupMenu</item>
        <item name="spinnerStyle">@style/Widget.AmniGuard.Spinner</item>

        <!-- Navigation Styles -->
        <item name="bottomNavigationStyle">@style/Widget.AmniGuard.BottomNavigation</item>
        <item name="navigationViewStyle">@style/Widget.AmniGuard.NavigationDrawer</item>
    </style>

    <style name="Widget.AmniGuard.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="elevation">8dp</item>
        <item name="itemIconSize">24dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <style name="Widget.AmniGuard.NavigationDrawer" parent="Widget.Material3.NavigationView">
        <item name="elevation">16dp</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="itemTextColor">?android:attr/textColorPrimary</item>
        <item name="itemIconTint">?attr/colorPrimary</item>
    </style>

    <style name="Widget.AmniGuard.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke_color</item>
    </style>

    <style name="AppThemeTeal" parent="BaseThemeLight">
        <item name="colorPrimary">@color/colorTealPrimary</item>
        <item name="colorPrimaryDark">@color/colorTealPrimaryDark</item>
        <item name="colorAccent">@color/colorTealAccent</item>
        <item name="colorOn">@color/colorTealOn</item>
        <item name="colorOff">@color/colorTealOff</item>
    </style>

    <style name="AppThemeTealDark" parent="BaseThemeDark">
        <item name="colorPrimary">@color/colorTealAccent</item>
        <item name="colorPrimaryDark">@color/colorTealPrimaryDark</item>
        <item name="colorAccent">@color/colorTealAccent</item>
        <item name="colorOn">@color/colorTealAccent</item>
        <item name="colorOff">@color/colorTealOff</item>
    </style>

    <style name="AppThemeBlue" parent="BaseThemeLight">
        <item name="colorPrimary">@color/colorBluePrimary</item>
        <item name="colorPrimaryDark">@color/colorBluePrimaryDark</item>
        <item name="colorAccent">@color/colorBlueAccent</item>
        <item name="colorOn">@color/colorBlueOn</item>
        <item name="colorOff">@color/colorBlueOff</item>
    </style>

    <style name="AppThemeBlueDark" parent="BaseThemeDark">
        <item name="colorPrimary">@color/colorBlueAccent</item>
        <item name="colorPrimaryDark">@color/colorBluePrimaryDark</item>
        <item name="colorAccent">@color/colorBlueAccent</item>
        <item name="colorOn">@color/colorBlueAccent</item>
        <item name="colorOff">@color/colorBlueOff</item>
    </style>

    <style name="AppThemePurple" parent="BaseThemeLight">
        <item name="colorPrimary">@color/colorPurplePrimary</item>
        <item name="colorPrimaryDark">@color/colorPurplePrimaryDark</item>
        <item name="colorAccent">@color/colorPurpleAccent</item>
        <item name="colorOn">@color/colorPurpleOn</item>
        <item name="colorOff">@color/colorPurpleOff</item>
    </style>

    <style name="AppThemePurpleDark" parent="BaseThemeDark">
        <item name="colorPrimary">@color/colorPurpleAccent</item>
        <item name="colorPrimaryDark">@color/colorPurplePrimaryDark</item>
        <item name="colorAccent">@color/colorPurpleAccent</item>
        <item name="colorOn">@color/colorPurpleAccent</item>
        <item name="colorOff">@color/colorPurpleOff</item>
    </style>

    <style name="AppThemeAmber" parent="BaseThemeLight">
        <item name="colorPrimary">@color/colorAmberPrimary</item>
        <item name="colorPrimaryDark">@color/colorAmberPrimaryDark</item>
        <item name="colorAccent">@color/colorAmberAccent</item>
        <item name="colorOn">@color/colorAmberOn</item>
        <item name="colorOff">@color/colorAmberOff</item>
    </style>

    <style name="AppThemeAmberDark" parent="BaseThemeDark">
        <item name="colorPrimary">@color/colorAmberPrimary</item>
        <item name="colorPrimaryDark">@color/colorAmberPrimaryDark</item>
        <item name="colorAccent">@color/colorAmberAccent</item>
        <item name="colorOn">@color/colorAmberOn</item>
        <item name="colorOff">@color/colorAmberOff</item>
    </style>

    <style name="AppThemeOrange" parent="BaseThemeLight">
        <item name="colorPrimary">@color/colorOrangePrimary</item>
        <item name="colorPrimaryDark">@color/colorOrangePrimaryDark</item>
        <item name="colorAccent">@color/colorOrangeAccent</item>
        <item name="colorOn">@color/colorOrangeOn</item>
        <item name="colorOff">@color/colorOrangeOff</item>
    </style>

    <style name="AppThemeOrangeDark" parent="BaseThemeDark">
        <item name="colorPrimary">@color/colorOrangePrimary</item>
        <item name="colorPrimaryDark">@color/colorOrangePrimaryDark</item>
        <item name="colorAccent">@color/colorOrangeAccent</item>
        <item name="colorOn">@color/colorOrangeOff</item>
        <item name="colorOff">@color/colorOrangeOff</item>
    </style>

    <style name="AppThemeGreen" parent="BaseThemeLight">
        <item name="colorPrimary">@color/colorGreenPrimary</item>
        <item name="colorPrimaryDark">@color/colorGreenPrimaryDark</item>
        <item name="colorAccent">@color/colorGreenAccent</item>
        <item name="colorOn">@color/colorGreenOn</item>
        <item name="colorOff">@color/colorGreenOff</item>
    </style>

    <style name="AppThemeGreenDark" parent="BaseThemeDark">
        <item name="colorPrimary">@color/colorGreenAccent</item>
        <item name="colorPrimaryDark">@color/colorGreenPrimaryDark</item>
        <item name="colorAccent">@color/colorGreenAccent</item>
        <item name="colorOn">@color/colorGreenAccent</item>
        <item name="colorOff">@color/colorGreenOff</item>
    </style>

    <!-- AmniGuard Canonical Brand Theme Styles -->
    <!-- 1. Sunset Glow (Warm Sand & Terracotta - Light Theme) -->
    <style name="AppThemeSunset" parent="BaseThemeLight">
        <item name="colorPrimary">@color/colorSunsetPrimary</item>
        <item name="colorPrimaryDark">@color/colorSunsetPrimaryDark</item>
        <item name="colorAccent">@color/colorSunsetAccent</item>
        <item name="colorOn">@color/colorSunsetPrimary</item>
        <item name="colorOff">@color/colorTealOff</item>
        <item name="android:windowBackground">@color/colorSunsetBg</item>
        <item name="android:colorBackground">@color/colorSunsetBg</item>
    </style>

    <!-- 2. Emerald Calm (Pearl Teal & Sage - Light Theme) -->
    <style name="AppThemeEmerald" parent="BaseThemeLight">
        <item name="colorPrimary">@color/colorEmeraldPrimary</item>
        <item name="colorPrimaryDark">@color/colorEmeraldPrimaryDark</item>
        <item name="colorAccent">@color/colorEmeraldAccent</item>
        <item name="colorOn">@color/colorEmeraldPrimary</item>
        <item name="colorOff">@color/colorTealOff</item>
        <item name="android:windowBackground">@color/md_theme_background</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
    </style>

    <!-- 3. Cosmic Night (Deep Violet Tech - Dark Theme) -->
    <style name="AppThemeCosmic" parent="BaseThemeDark">
        <item name="colorPrimary">@color/colorCosmicPrimary</item>
        <item name="colorPrimaryDark">@color/colorCosmicPrimaryDark</item>
        <item name="colorAccent">@color/colorCosmicAccent</item>
        <item name="colorOn">@color/colorCosmicPrimary</item>
        <item name="colorOff">@color/colorTealOff</item>
        <item name="android:windowBackground">@color/colorCosmicBg</item>
        <item name="android:colorBackground">@color/colorCosmicBg</item>
    </style>
</resources>
